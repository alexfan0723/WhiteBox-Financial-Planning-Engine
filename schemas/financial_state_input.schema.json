{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whitebox.example/schemas/financial_state_input.schema.json",
  "title": "Financial State Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "household", "currency", "facts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "currency": {
      "type": "string",
      "examples": ["CNY"]
    },
    "market": {
      "type": "string",
      "examples": ["mainland_china"]
    },
    "household": {
      "type": "object",
      "additionalProperties": true
    },
    "facts": {
      "type": "object",
      "additionalProperties": true
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
